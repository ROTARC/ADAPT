# Data and output: ignore contents, keep the folder structure
data/**
!data/**/
!data/**/.gitkeep
output/**
!output/**/
!output/**/.gitkeep

# Secrets and local environment
.env

# Configuration files
config/.*
config/*.local.toml
!config/*.example.toml

# Environments, editors, caches
.venv/
.conda/
.vscode/
.*cache/
__pycache__/
.ipynb_checkpoints/
.DS_Store